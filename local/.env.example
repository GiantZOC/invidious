# Copy to .env (chmod 600) and fill in. .env is gitignored.
# Generate the secrets with:
#   HMAC_KEY=$(openssl rand -hex 20)
#   COMPANION_KEY=$(openssl rand -hex 8)     # exactly 16 chars, required
#   POSTGRES_PASSWORD=*** rand -hex 24)

HMAC_KEY=
COMPANION_KEY=
POSTGRES_PASSWORD=
*** API token from /token_manager; empty disables the collector.
INVIDIOUS_TOKEN=
TS_HOST=steve-mint.tail9d4465.ts.net
REGISTRATION_ENABLED=true
